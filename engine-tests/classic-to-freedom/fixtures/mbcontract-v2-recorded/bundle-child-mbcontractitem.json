 "handlers": "[\n\t\t\t{\n\t\t\t\trequest: \"crt.HandleViewModelInitRequest\",\n\t\t\t\thandler: async (request, next) => {\n\t\t\t\t\tconst result = await next?.handle(request);\n\t\t\t\t\tawait itemPage.setNewItemActive(request.$context);\n\t\t\t\t\treturn result;\n\t\t\t\t}\n\t\t\t},\n\t\t\t{\n\t\t\t\trequest: \"crt.HandleViewModelInitRequest\",\n\t\t\t\thandler: async (request, next) => {\n\t\t\t\t\tconst result = await next?.handle(request);\n\t\t\t\t\tawait itemPage.markPageReady(request.$context);\n\t\t\t\t\treturn result;\n\t\t\t\t}\n\t\t\t},\n\t\t\t{\n\t\t\t\trequest: \"crt.HandleViewModelAttributeChangeRequest\",\n\t\t\t\thandler: async (request, next) => {\n\t\t\t\t\tif (!itemPage.isTotalSource(request.attributeName)) {\n\t\t\t\t\t\treturn next?.handle(request);\n\t\t\t\t\t}\n\t\t\t\t\tconst result = await next?.handle(request);\n\t\t\t\t\tawait itemPage.recalculateTotal(request.$context, request.attributeName, request.value, request.silent);\n\t\t\t\t\treturn result;\n\t\t\t\t}\n\t\t\t}\n\t\t]",
 "deps": "[\"UsrMbContractsV2App_MbContractItemMiniPageModule\"]",
 "args": "(itemPage)",
 "validators": "{}",
 "converters": "{}"
