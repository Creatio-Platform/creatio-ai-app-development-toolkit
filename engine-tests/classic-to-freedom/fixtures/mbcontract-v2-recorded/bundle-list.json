 "handlers": "[\n\t\t\t{\n\t\t\t\trequest: \"mb.CloseSelectedClicked\",\n\t\t\t\thandler: async (request, next) => {\n\t\t\t\t\tconst selectionState = await request.$context.DataTable_SelectionState;\n\t\t\t\t\tawait listPage.closeSelectedContracts(request.$context, request.scopes, selectionState);\n\t\t\t\t\treturn next?.handle(request);\n\t\t\t\t}\n\t\t\t}\n\t\t]",
 "deps": "[\"UsrMbContractsV2App_ListPageModule\"]",
 "args": "(listPage)",
 "validators": "{}",
 "converters": "{\n\t\t\t\"mb.ToCloseSelectionEmpty\": function(selectionState) {\n\t\t\t\treturn listPage.isCloseSelectionEmpty(selectionState);\n\t\t\t}\n\t\t}"
