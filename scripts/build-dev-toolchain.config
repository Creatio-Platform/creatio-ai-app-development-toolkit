# build-dev-toolchain.config -- local machine paths for build-dev-toolchain.bat
# Format: KEY=VALUE, one per line. No spaces around '='. Lines starting with '#' are comments.
# Edit these to match YOUR local checkout layout.

# clio source checkout -- Stage A builds + packs this into the global tool.
# This is the ONLY required key.
CLIO_SRC=C:\Projects\clio

# NOTE: the CAADT repo path is NO LONGER configured here. This script lives inside the repo
# (<repo>\scripts\), so Stage B derives the repo root from its own location and GENERATES the
# local dev marketplace under TEMP automatically -- no marketplace.json to hand-create.

# Claude marketplace name to register the generated local dev marketplace under. Optional (default: creatio).
# MARKETPLACE_NAME=creatio

# clio-knowledge git URL -- Stage C git-override source. Branch is chosen at run time (step [0/7]).
KN_URL=https://github.com/Advance-Technologies-Foundation/clio-knowledge.git

# Optional default knowledge branch (skips the step [0/7] menu when set). A script arg overrides this.
# KN_BRANCH=master

# dotnet build configuration for the clio build/pack.
CONFIG=Release
