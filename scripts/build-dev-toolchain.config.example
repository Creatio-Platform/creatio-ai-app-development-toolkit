# build-dev-toolchain.config -- local machine paths for the build-dev-toolchain launchers
# (build-dev-toolchain.bat on Windows, build-dev-toolchain.sh on macOS/Linux; both run build_dev_toolchain.py).
# Format: KEY=VALUE, one per line. No spaces around '='. Lines starting with '#' are comments.
#
# SETUP: copy this file to "build-dev-toolchain.config" (same folder) and edit the values for YOUR
#        machine. The real config is gitignored, so your local paths never show up as a repo diff.

# clio source checkout -- Stage A builds + packs this into the global tool.
# REQUIRED. Replace the placeholder with the absolute path to your local clio checkout.
CLIO_SRC=<path-to-your-local-clio-checkout>

# NOTE: the CAADT repo path is NO LONGER configured here. This script lives inside the repo
# (<repo>\scripts\), so Stage B derives the repo root from its own location and GENERATES the
# local dev marketplace under TEMP automatically -- no marketplace.json to hand-create.

# Claude marketplace name to register the generated local dev marketplace under. Optional (default: creatio).
# MARKETPLACE_NAME=creatio

# clio-knowledge git URL -- Stage C git-override source. Branch is chosen at run time (step [0/7]).
# Optional (default: the Advance-Technologies-Foundation/clio-knowledge repo below).
# KN_URL=https://github.com/Advance-Technologies-Foundation/clio-knowledge.git

# Optional default knowledge-source MODE: "release" (signed bundle) or "branch" (git override).
# Skips the step [0/7] menu when set. A `release` script arg forces release; any other arg forces branch.
# KN_MODE=release

# Optional default knowledge branch/tag (used in branch mode; skips the [0/7] menu). A script arg overrides.
# KN_BRANCH=master

# dotnet build configuration for the clio build/pack. Optional (default: Release).
# CONFIG=Release
